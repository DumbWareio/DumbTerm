{
  "name": "dumbterm",
  "version": "1.3.0",
  "description": "A stupidly simple web-based terminal emulator, with common tools and Starship enabled (via Docker)! 🚀",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run copy-xterm && node server.js",
    "dev": "npm run copy-xterm && nodemon server.js",
    "copy-xterm": "node scripts/copy-xterm.js",
    "postinstall": "node -e \"process.platform === 'darwin' && require('./scripts/fix-node-pty-permissions.js')\"",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
